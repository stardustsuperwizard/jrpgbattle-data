{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abilities.schema.json",
  "title": "world/abilities.json, jrpgbattle world format 2026-11-26",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9_]*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/ability"
  },
  "$defs": {
    "ability": {
      "$ref": "common.schema.json#/$defs/skill"
    }
  }
}
