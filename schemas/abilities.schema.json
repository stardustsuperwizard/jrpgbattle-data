{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "abilities.schema.json",
  "title": "setting/abilities.json, content format 2026-11-11",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9_]*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/ability"
  },
  "$defs": {
    "ability": {
      "$ref": "common.schema.json#/$defs/skill"
    }
  }
}
