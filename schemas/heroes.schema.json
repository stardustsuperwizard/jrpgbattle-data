{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heroes.schema.json",
  "title": "setting/heroes.json, content format 2026-11-15",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9][a-z0-9_]*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/hero"
  },
  "$defs": {
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sprite",
        "reach",
        "class",
        "characterGroup",
        "damageType",
        "maxHp",
        "physAtk",
        "magAtk",
        "physRes",
        "magRes",
        "spd",
        "abilities"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sprite": {
          "type": "string",
          "minLength": 1,
          "description": "Its emoji or placeholder; a skin draws it by id."
        },
        "reach": {
          "enum": [
            "melee",
            "ranged"
          ],
          "description": "How it fights, for a client drawing a unit it has no art for (decision 0052). No rule reads it."
        },
        "damageType": {
          "$ref": "common.schema.json#/$defs/damageTypeId"
        },
        "maxHp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "physAtk": {
          "type": "number",
          "minimum": 0
        },
        "magAtk": {
          "type": "number",
          "minimum": 0
        },
        "physRes": {
          "type": "number",
          "minimum": 0
        },
        "magRes": {
          "type": "number",
          "minimum": 0
        },
        "spd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "role": {
          "type": "string",
          "description": "Shown in the UI."
        },
        "characterGroup": {
          "type": "string",
          "minLength": 1,
          "description": "The set of heroes it belongs to, such as Gods of Olympus (decision 0054). A title for a client; no rule reads it."
        },
        "class": {
          "type": "string",
          "minLength": 1,
          "description": "What job it does in a line-up, such as Guardian or Support (decision 0054). A label for a client and what the bot's pick spreads on; no rule reads it."
        },
        "ai": {
          "enum": [
            "default",
            "healer",
            "charger"
          ],
          "description": "The enemy AI; default when unset. A healer needs a skill with special heal, a charger chargeEvery and one charge and one release skill."
        },
        "chargeEvery": {
          "type": "integer",
          "minimum": 1,
          "description": "A charger winds up every this many actions; only a charger has it."
        },
        "critRate": {
          "type": "number",
          "minimum": 0
        },
        "critDmg": {
          "type": "number",
          "minimum": 0
        },
        "maxEnergy": {
          "type": "number",
          "minimum": 0
        },
        "toughness": {
          "type": "number",
          "minimum": 0
        },
        "growth": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "maxHp": {
              "type": "number",
              "minimum": 0
            },
            "physAtk": {
              "type": "number",
              "minimum": 0
            },
            "magAtk": {
              "type": "number",
              "minimum": 0
            },
            "physRes": {
              "type": "number",
              "minimum": 0
            },
            "magRes": {
              "type": "number",
              "minimum": 0
            },
            "spd": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "Stats gained per level."
        },
        "xp": {
          "type": "number",
          "minimum": 0,
          "description": "Paid to whoever defeats it."
        },
        "gold": {
          "type": "number",
          "minimum": 0,
          "description": "Paid to whoever defeats it."
        },
        "abilities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": "Its default set, by ability id (abilities.json): exactly one basic, one skill and one ultimate."
        },
        "forms": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "abilities"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Shown when the hero takes the form."
              },
              "abilities": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "description": "The form's set, by ability id: exactly one basic, one skill and one ultimate."
              }
            }
          },
          "description": "Other forms the hero can take in battle (decision 0060), by id: a form effect in one of its abilities switches to one. Optional."
        },
        "defaultLoadout": {
          "$ref": "common.schema.json#/$defs/loadout",
          "description": "What the champion wears where a mode offers loadouts and nobody chose (decision 0058): every item in its slot's pool (slots.json). Optional; without it, nothing."
        }
      }
    }
  }
}
