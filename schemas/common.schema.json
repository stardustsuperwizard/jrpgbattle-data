{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared content shapes, content format 2026-11-15",
  "description": "Shapes more than one content file uses: ids, stats, skills and their effects. The other schemas refer to these.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "description": "An id: lowercase letters, digits and _, starting with a letter or digit."
    },
    "slotId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "A slot's id (decision 0058): lowercase letters, digits, - and _."
    },
    "loadout": {
      "type": "object",
      "description": "What a champion wears, by slot id (decision 0058): each key one of the world's slots (slots.json), each value the id of an item worn in that slot. A slot left out holds nothing.",
      "propertyNames": {
        "$ref": "#/$defs/slotId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/id"
      }
    },
    "damageTypeId": {
      "type": "string",
      "minLength": 1,
      "description": "A damage type id, one of core/damageTypes.json's (physical or magic). The schema can't list them: the engine checks it when the content loads."
    },
    "elementId": {
      "type": "string",
      "minLength": 1,
      "description": "An element id, one of core/elements.json's (fire, lightning, metal and so on). The schema can't list them: the engine checks it when the content loads."
    },
    "statusId": {
      "type": "string",
      "minLength": 1,
      "description": "A status id, one of core/statuses.json's, checked when the content loads."
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "maxHp": {
          "type": "number"
        },
        "physAtk": {
          "type": "number"
        },
        "magAtk": {
          "type": "number"
        },
        "physRes": {
          "type": "number"
        },
        "magRes": {
          "type": "number"
        },
        "spd": {
          "type": "number"
        }
      },
      "description": "Flat stat changes, by stat."
    },
    "effectOn": {
      "enum": [
        "target",
        "self",
        "all_allies",
        "fallen_allies"
      ],
      "description": "Who an effect lands on: the skill's targets (the default), the user, every living ally of the user, or every fallen one (only a revive, decision 0061)."
    },
    "effect": {
      "description": "One building block of a skill, by `type`. A field the type doesn't have is refused.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "mult"
          ],
          "properties": {
            "type": {
              "const": "damage"
            },
            "mult": {
              "type": "number",
              "minimum": 0,
              "description": "Of the user's ATK."
            },
            "toughness": {
              "type": "number",
              "minimum": 0,
              "description": "Toughness removed from the target by the hit."
            },
            "on": {
              "$ref": "#/$defs/effectOn"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "heal"
            },
            "pctMaxHp": {
              "type": "number",
              "minimum": 0,
              "description": "Of the recipient's max HP."
            },
            "flat": {
              "type": "number",
              "minimum": 0
            },
            "on": {
              "$ref": "#/$defs/effectOn"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "duration"
          ],
          "properties": {
            "type": {
              "const": "shield"
            },
            "duration": {
              "type": "integer",
              "minimum": 1,
              "description": "Turns."
            },
            "resRatio": {
              "type": "number",
              "minimum": 0,
              "description": "Of the user's average of physical and magic resistance."
            },
            "flat": {
              "type": "number",
              "minimum": 0
            },
            "on": {
              "$ref": "#/$defs/effectOn"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "status",
            "duration"
          ],
          "properties": {
            "type": {
              "const": "status"
            },
            "status": {
              "$ref": "#/$defs/statusId"
            },
            "duration": {
              "type": "integer",
              "minimum": 1,
              "description": "Turns."
            },
            "chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "To apply, 0 to 1; always applies when unset."
            },
            "dotRatio": {
              "type": "number",
              "minimum": 0,
              "description": "Overrides the status's own, for a DoT."
            },
            "on": {
              "$ref": "#/$defs/effectOn"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "cleanse"
            },
            "on": {
              "$ref": "#/$defs/effectOn"
            }
          },
          "description": "Removes every cleansable status."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "status"
          ],
          "properties": {
            "type": {
              "const": "remove_status"
            },
            "status": {
              "$ref": "#/$defs/statusId"
            },
            "on": {
              "$ref": "#/$defs/effectOn"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "on"
          ],
          "properties": {
            "type": {
              "const": "revive"
            },
            "on": {
              "const": "fallen_allies",
              "description": "A revive lands only on the user's fallen allies."
            },
            "pctMaxHp": {
              "type": "number",
              "minimum": 0,
              "description": "Of the recipient's max HP."
            },
            "flat": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "Stands every fallen ally of the user up, with this share of its max HP plus `flat`, at the back of the turn order (decision 0061). One of `pctMaxHp` and `flat` must be above zero."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "form"
            },
            "form": {
              "$ref": "#/$defs/id",
              "description": "One of the hero's `forms` (heroes.json); left out, the hero's own abilities again."
            },
            "on": {
              "$ref": "#/$defs/effectOn",
              "description": "Only the user: `self`, or the target of a skill on `self`."
            }
          },
          "description": "Changes the user's form (decision 0061): its abilities become the form's, or its own again. Only a hero has forms."
        }
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "target",
        "effects"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "basic",
            "skill",
            "ultimate"
          ]
        },
        "target": {
          "enum": [
            "enemy",
            "ally",
            "blast",
            "all_enemies",
            "all_allies",
            "self"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "description": {
          "type": "string",
          "description": "Shown in the UI."
        },
        "damageType": {
          "$ref": "#/$defs/damageTypeId",
          "description": "Defaults to the user's damage type."
        },
        "element": {
          "$ref": "#/$defs/elementId",
          "description": "The kind of force it is (fire, lightning, metal): a client's animation and sound for now (decision 0057). Optional: a skill with no element has none."
        },
        "splash": {
          "type": "number",
          "minimum": 0,
          "description": "A blast's multiplier on the primary target's neighbours."
        },
        "spGain": {
          "type": "number",
          "minimum": 0
        },
        "spCost": {
          "type": "number",
          "minimum": 0
        },
        "energyGain": {
          "type": "number",
          "minimum": 0
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "How often the enemy AI picks it, against its other skills."
        },
        "message": {
          "type": "string",
          "description": "Shown when used; {user} becomes the user's name."
        },
        "special": {
          "enum": [
            "heal",
            "charge",
            "release"
          ],
          "description": "Kept for an AI rule (a healer's heal, a charger's charge and release), out of the random picks."
        }
      },
      "description": "A skill: a champion's ability (abilities.json) or a monster's own (enemies.json). spGain, spCost and energyGain come from the rules for its type when left out."
    }
  }
}
